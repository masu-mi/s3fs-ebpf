# default.cel — CEL policy spike (Week 4 (d) P-01)
#
# Format: one line per hook, `hook: <cel expression>`. Blank lines
# and `#` comments allowed. Unknown hook names are ignored (forward
# compat). See daemon/internal/policy/policy.go for the loader.
#
# Contract:
#   entry.ino    (uint64)  daemon-assigned inode, stable within run
#   entry.name   (string)  dentry basename
#   entry.s3_key (string)  full S3 key (may contain '/')
#   entry.size   (uint64)  S3 stat'd size in bytes
#   entry.mode   (uint64)  Unix mode bits
#
# Hooks:
#   prewarm: bool — should the daemon prewarm this entry at startup?
#                    default (no policy loaded / eval err) = true
#   policy:  string — which Layer 2 BPF policy program to attach.
#                     Empty / not declared → --policy-bpf flag wins.
#                     Values: "builtin:<name>" (repo bpf/<name>.bpf.o),
#                             "file:<path>" (Layer 3 user .bpf.o), or
#                             a bare name treated as builtin:<name>.

# Prewarm everything ≤ 32 MiB except *.log files. Larger blobs and
# rotating logs go through Path C (on-demand) instead — the write-back
# for logs would fight the sync loop, and >32 MiB weights we'd rather
# demand-load to keep arena churn low.
prewarm: entry.size <= 33554432 && !entry.name.endsWith(".log")

# Global policy selection: struct_ops S3-FIFO for atomic hot swap +
# fmod_ret return-value dispatch (see docs/policy-attach-comparison.md).
policy: "builtin:policy_s3fifo_ops"
