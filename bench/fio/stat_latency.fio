# Metadata (stat) latency micro-benchmark.
# Assumes MOUNT_POINT is populated with ~10,000 tiny files by runner.sh.
# Measured metric: getattr / newfstatat latency distribution.

[global]
name=s3fs-ebpf-stat-latency
directory=${MOUNT_POINT}
filename_format=$jobnum/$filenum
nrfiles=10000
filesize=4k
create_only=0
create_on_open=0
openfiles=1
fallocate=none
time_based=1
runtime=30s
group_reporting=1
stonewall

[stat-serial]
rw=randread
bs=4k
ioengine=filestat
iodepth=1
numjobs=1
