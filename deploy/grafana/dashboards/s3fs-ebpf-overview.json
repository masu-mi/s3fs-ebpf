{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Fast Path Hit Ratio",
      "type": "stat",
      "description": "fast_hits / (fast_hits + slow_misses) over the last 1 min. Zero on cold start until BPF fentry sees getattr traffic.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(s3fs_ebpf_fast_path_hits_total[1m])) / clamp_min(sum(rate(s3fs_ebpf_fast_path_hits_total[1m])) + sum(rate(s3fs_ebpf_slow_path_misses_total[1m])), 1)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Admits (arena entries)",
      "type": "stat",
      "description": "Current number of ino → arena-uaddr entries in the admit table. Rises with prewarm/Path C admits.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "s3fs_ebpf_admits_current" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Sync entries (dyn table)",
      "type": "stat",
      "description": "Entries in kmod's dyn entry table after the last successful sync round.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "s3fs_ebpf_sync_entries_current" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Arena usage",
      "type": "gauge",
      "description": "High-water bytes written by AdmitContent, divided by arena capacity. Grows monotonically until daemon restart — gc は未実装 (lessons §5.4).",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "s3fs_ebpf_arena_used_bytes / clamp_min(s3fs_ebpf_arena_capacity_bytes, 1)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "VFS getattr rate — fast vs slow",
      "type": "timeseries",
      "description": "Per-second rate of fentry-observed getattr calls, split by admit-hit (fast) and admit-miss (slow). unknown_fs は他 FS の getattr が来た数 (noise の目安)。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_fast_path_hits_total[1m])",    "legendFormat": "fast" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_slow_path_misses_total[1m])",  "legendFormat": "slow" },
        { "refId": "C", "expr": "rate(s3fs_ebpf_unknown_fs_total[1m])",        "legendFormat": "unknown_fs" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 6,
      "title": "Write-back throughput",
      "type": "timeseries",
      "description": "J-04: bytes/s (left) と events/s + mean bytes/req (右 override) を同 panel に。events が上がっても bytes が上がらなければ小 file の連発、逆なら大 blob の吐き出しと切り分けられる。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_flush_bytes_total[1m])", "legendFormat": "PUT bytes/s" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_flush_events_total[1m])", "legendFormat": "PUT req/s" },
        { "refId": "C", "expr": "rate(s3fs_ebpf_flush_bytes_total[1m]) / clamp_min(rate(s3fs_ebpf_flush_events_total[1m]), 1)", "legendFormat": "mean bytes/req" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Bps" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "PUT req/s" },       "properties": [{ "id": "unit", "value": "reqps" }] },
          { "matcher": { "id": "byName", "options": "mean bytes/req" }, "properties": [{ "id": "unit", "value": "bytes" }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 7,
      "title": "Read-miss upcalls (Path C)",
      "type": "timeseries",
      "description": "Rate of read-miss upcalls from kmod to daemon. Errors line rises when S3 Get / AdmitContent fail.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_read_miss_upcalls_total[1m])", "legendFormat": "upcalls" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_read_miss_errors_total[1m])",  "legendFormat": "errors" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 8,
      "title": "Flush events",
      "type": "timeseries",
      "description": "Rate of flush events drained by the daemon (post-coalescer). エラー分は右の stat panel を参照。",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_flush_events_total[1m])", "legendFormat": "events" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 23,
      "title": "Flush errors (last 5m)",
      "type": "stat",
      "description": "Number of failed PUTs in the last 5 min. Green = 0 (normal), Red = 1+ (S3 側 or 権限問題を疑う)。単純な rate だと 0 が地味に見えるので、閾値で色を切り替える stat 型にしている。",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(s3fs_ebpf_flush_errors_total[5m]))", "legendFormat": "errors" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 9,
      "title": "Sync rounds / errors",
      "type": "timeseries",
      "description": "Rate of successful sync rounds vs errors. 定期 --sync-every に沿って階段状に増える。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_sync_rounds_total[1m])", "legendFormat": "rounds" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_sync_errors_total[1m])", "legendFormat": "errors" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 10,
      "title": "Host context switches / sec",
      "type": "timeseries",
      "description": "node_exporter からの host-side context switch。fuse-fs bench 中は高、ebpf-fs bench 中は低いことを期待。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_context_switches_total[1m])", "legendFormat": "context switches" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 11,
      "title": "Host CPU% (user / sys / iowait / softirq / irq / nice / steal)",
      "type": "timeseries",
      "description": "J-03: 全 CPU 平均。BPF fentry が softirq 側に載っていれば softirq/irq が bench 時に跳ねる。steal は共有 VM/ゲストで cloud 側 CPU 枯渇の signal。iowait が高いと S3 backend が bottleneck。",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m])) * 100",    "legendFormat": "user" },
        { "refId": "B", "expr": "avg(rate(node_cpu_seconds_total{mode=\"system\"}[1m])) * 100",  "legendFormat": "sys"  },
        { "refId": "C", "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[1m])) * 100",  "legendFormat": "iowait" },
        { "refId": "D", "expr": "avg(rate(node_cpu_seconds_total{mode=\"softirq\"}[1m])) * 100", "legendFormat": "softirq" },
        { "refId": "E", "expr": "avg(rate(node_cpu_seconds_total{mode=\"irq\"}[1m])) * 100",     "legendFormat": "irq" },
        { "refId": "F", "expr": "avg(rate(node_cpu_seconds_total{mode=\"nice\"}[1m])) * 100",    "legendFormat": "nice" },
        { "refId": "G", "expr": "avg(rate(node_cpu_seconds_total{mode=\"steal\"}[1m])) * 100",   "legendFormat": "steal" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 12,
      "title": "MinIO S3 traffic (bytes)",
      "type": "timeseries",
      "description": "MinIO 側 metric。rate() で GET/PUT byte 速度を見る。exposition path が違う場合 (metric 名変更)、Prometheus targets タブで s3fs_ebpf_daemon / minio が UP か先に確認する。",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(minio_s3_traffic_received_bytes[1m])", "legendFormat": "received (uploaded)" },
        { "refId": "B", "expr": "rate(minio_s3_traffic_sent_bytes[1m])",     "legendFormat": "sent (downloaded)" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "id": 13,
      "title": "Policy hook rate (invocations / s)",
      "type": "timeseries",
      "description": "Rate of BPF policy on_admit hook invocations. Rises with sync + Path C activity. Zero when no --policy-bpf attached.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_policy_hook_invocations_total[1m])", "legendFormat": "on_admit" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 14,
      "title": "Policy evictions (total / rate)",
      "type": "timeseries",
      "description": "kmod side hash_del count driven by policy vote (struct_ops eval_evict return 1). Fires when admits exceed softcap (8). Cumulative counter + rate; a growing rate means the policy is actively pruning the admit table.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "s3fs_ebpf_policy_evictions_total",              "legendFormat": "cumulative" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_policy_evictions_total[1m])",    "legendFormat": "rate/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 15,
      "title": "Policy state (last admit count)",
      "type": "stat",
      "description": "Snapshot count the policy BPF program last saw. Should track admits_current unless kmod eviction lags.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "s3fs_ebpf_policy_last_admit_count", "legendFormat": "last admit_count" },
        { "refId": "B", "expr": "s3fs_ebpf_admits_current",          "legendFormat": "daemon snapshot" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 16,
      "title": "Read-miss latency (p50 / p95 / p99)",
      "type": "timeseries",
      "description": "Daemon-side upcall service time (S3 Get + arena write + admit ioctl). Computed with histogram_quantile over 5m windows. p99 spikes track cold-object fetches; p50 is warm-hit-arena baseline.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(s3fs_ebpf_read_miss_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(s3fs_ebpf_read_miss_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(s3fs_ebpf_read_miss_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 17,
      "title": "Read-miss latency distribution (heatmap)",
      "type": "heatmap",
      "description": "Full bucket distribution over time — dense stripes = steady behavior, scattered dots = tail spikes.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(s3fs_ebpf_read_miss_latency_seconds_bucket[1m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}" }
      ],
      "options": { "calculate": false, "yAxis": { "unit": "s" }, "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "reverse": true } }
    },
    {
      "id": 18,
      "title": "Flush latency (p50 / p95 / p99)",
      "type": "timeseries",
      "description": "Daemon-side write-back path: readDirty + S3 PUT + arena admit refresh. Symmetric with the read-miss panel — together they show both directions of the miss/flush cycle.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(s3fs_ebpf_flush_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(s3fs_ebpf_flush_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(s3fs_ebpf_flush_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 19,
      "title": "Flush latency distribution (heatmap)",
      "type": "heatmap",
      "description": "Full bucket distribution for the flush path.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(s3fs_ebpf_flush_latency_seconds_bucket[1m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}" }
      ],
      "options": { "calculate": false, "yAxis": { "unit": "s" }, "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64, "reverse": true } }
    },
    {
      "id": 20,
      "title": "kmod cache hit ratio (true)",
      "type": "stat",
      "description": "read_folio arena hits / (arena hits + upcalls). This is the actual cache hit rate at the kmod level, independent of fentry-side getattr counters. 100 % = every read served from arena.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "s3fs_ebpf_folio_hits_total / clamp_min(s3fs_ebpf_folio_hits_total + s3fs_ebpf_read_miss_upcalls_total, 1)",
          "legendFormat": "hit ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 21,
      "title": "kmod folio hits vs upcalls (rate)",
      "type": "timeseries",
      "description": "Per-second rate of arena-served folios vs upcall-served folios. The green area shrinking / red area growing = policy is evicting hot items.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 70 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_folio_hits_total[1m])", "legendFormat": "arena hits/s" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_read_miss_upcalls_total[1m])", "legendFormat": "upcalls/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } }
    },
    {
      "id": 22,
      "title": "Policy custom metric ($policy_metric_name)",
      "type": "timeseries",
      "description": "Gauge emitted by CEL policies via metric(name, value) — see policies/default.cel. Use the dropdown to pick which name to graph. All (default) overlays every metric on one panel.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 76 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "s3fs_ebpf_policy_metric{name=~\"$policy_metric_name\"}", "legendFormat": "{{name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] } }
    },
    {
      "id": 24,
      "title": "Go runtime — goroutines + threads",
      "type": "timeseries",
      "description": "J-02: goroutine count と OS thread の伸び。bench 中に単調増加していれば goroutine leak (context cancel の失敗など) を疑う。thread は syscall parallelism の上限。job フィルタで prometheus / node_exporter 自身の runtime を除外して daemon のみを見る。",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 84 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "go_goroutines{job=\"s3fs_ebpf_daemon\"}", "legendFormat": "goroutines" },
        { "refId": "B", "expr": "go_threads{job=\"s3fs_ebpf_daemon\"}",    "legendFormat": "OS threads" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] } }
    },
    {
      "id": 25,
      "title": "Go heap — alloc / sys / next GC",
      "type": "timeseries",
      "description": "J-02: 生きている heap object のバイト数 + Go runtime が OS から取ってきた総メモリ + 次 GC 発火閾値。next_gc 直下で alloc が横ばいなら GC 走行中、超えたら次 GC まで直線的に伸びる。",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 84 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "go_memstats_alloc_bytes{job=\"s3fs_ebpf_daemon\"}",   "legendFormat": "alloc" },
