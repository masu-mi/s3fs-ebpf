  "panels": [
    {
      "id": 1,
      "title": "Fast Path Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(s3fs_ebpf_fast_path_hits_total[1m])) / (sum(rate(s3fs_ebpf_fast_path_hits_total[1m])) + sum(rate(s3fs_ebpf_slow_path_misses_total[1m])))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "VFS Requests / sec (fast vs slow)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(s3fs_ebpf_fast_path_hits_total[1m])",   "legendFormat": "fast" },
        { "refId": "B", "expr": "rate(s3fs_ebpf_slow_path_misses_total[1m])", "legendFormat": "slow" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "Context Switches / sec (host)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(node_context_switches_total[1m])" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "MinIO S3 requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (api) (rate(minio_s3_requests_total[1m]))", "legendFormat": "{{api}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ],
